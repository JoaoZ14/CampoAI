{
  "name": "agroassist-backend",
  "version": "1.0.0",
  "description": "Backend AGGI — assistente rural via WhatsApp (Twilio + Gemini + Supabase)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "npm --prefix app ci --offline=false && npm --prefix app run build",
    "preview:app": "node --import dotenv/config scripts/previewApp.mjs",
    "test": "node --test test/rural.test.js test/agro.test.js test/dashboard.test.js",
    "test:rural": "node test/rural.test.js",
    "test:agro": "node test/agro.test.js",
    "test:agro-ui": "node scripts/test-agro-ui.mjs",
    "verify:agro-schema": "node scripts/verify-agro-schema.mjs",
    "test:app-ui": "node scripts/test-app-ui.mjs",
    "test:dashboard-ui": "node scripts/test-dashboard-ui.mjs",
    "worker:rural": "node scripts/runRuralWorker.mjs",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "weekly-news": "node scripts/sendWeeklyNewsOnce.mjs",
    "weekly-news:send": "node scripts/sendWeeklyNewsOnce.mjs",
    "test:signup-flow": "node scripts/test-signup-flow.mjs",
    "test:signup-email": "node scripts/sendSignupWelcomeEmailOnce.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "validate:funnel": "node scripts/validate-prod-funnel.mjs",
    "confirm:migrations": "node scripts/confirm-migrations.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "whatsapp",
    "agriculture",
    "gemini",
    "twilio",
    "supabase"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.73.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.18.0",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8"
  }
}
