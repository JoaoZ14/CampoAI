# Apply migrations 021, 022, 023 before enabling. Existing .env remains unchanged.
AGENT_TOOLS_ENABLED=false
FARM_MEMORY_ENABLED=false
WEATHER_ENABLED=false
REMINDERS_ENABLED=false
EXPENSES_ENABLED=false
INVENTORY_ENABLED=false
OCCURRENCES_ENABLED=false
FARM_MEDIA_ENABLED=false
FARM_REPORTS_ENABLED=false

# Optional; defaults to GEMINI_MODEL / gemini-2.5-flash.
GEMINI_AGENT_MODEL=
GEMINI_AGENT_FALLBACK=gemini-2.5-flash
# Approved utility template. Variable {{1}} is the requested reminder / stock alert.
REMINDER_CONTENT_SID=
# Required for Open-Meteo's commercial endpoint in production.
OPEN_METEO_API_KEY=
# Existing landing JSON contract: { fetchedAt, items: [{ commodity, uf, price, unit, date, source }] }
MARKET_PRICES_URL=https://agassist.netlify.app/cotacoes.json
